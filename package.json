{
  "name": "tahaluh-codex-account-switcher",
  "displayName": "Codex Account Profiles",
  "description": "Manage authorized Codex account profiles in VS Code while keeping chats and sessions shared.",
  "version": "0.3.2",
  "publisher": "tahaluh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tahaluh/codex-account-profiles.git"
  },
  "homepage": "https://github.com/tahaluh/codex-account-profiles#readme",
  "bugs": {
    "url": "https://github.com/tahaluh/codex-account-profiles/issues"
  },
  "engines": {
    "vscode": ">=1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexAccountSwitcher",
          "title": "Codex Accounts",
          "icon": "resources/key.svg"
        }
      ]
    },
    "views": {
      "codexAccountSwitcher": [
        {
          "id": "codexAccountSwitcher.accountsView",
          "name": "Accounts",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codexAccountSwitcher.addAccount",
        "title": "Codex: Add Account"
      },
      {
        "command": "codexAccountSwitcher.importCurrentAccount",
        "title": "Codex: Import Current Account"
      },
      {
        "command": "codexAccountSwitcher.reauthenticateAccount",
        "title": "Codex: Re-authenticate Account"
      },
      {
        "command": "codexAccountSwitcher.exportAccounts",
        "title": "Codex: Export Accounts"
      },
      {
        "command": "codexAccountSwitcher.importAccounts",
        "title": "Codex: Import Accounts"
      },
      {
        "command": "codexAccountSwitcher.removeAccount",
        "title": "Codex: Remove Account"
      },
      {
        "command": "codexAccountSwitcher.showLimits",
        "title": "Codex: Show Account Limits"
      },
      {
        "command": "codexAccountSwitcher.switchAccount",
        "title": "Codex: Switch Account"
      },
      {
        "command": "codexAccountSwitcher.startCodex",
        "title": "Codex: Start with Available Account"
      },
      {
        "command": "codexAccountSwitcher.openLauncherFolder",
        "title": "Codex: Open Launcher Folder"
      },
      {
        "command": "codexAccountSwitcher.enableNativeIntegration",
        "title": "Codex: Enable Native Integration"
      }
    ],
    "configuration": {
      "title": "Codex Account Profiles",
      "properties": {
        "codexAccountSwitcher.autoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically select another available profile when starting Codex."
        },
        "codexAccountSwitcher.confirmBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before changing the selected profile."
        },
        "codexAccountSwitcher.minimumRemainingPercent": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum remaining quota required for a profile to be considered available."
        },
        "codexAccountSwitcher.autoSwitchHourlyThreshold": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "description": "When automatic switching is enabled, switch away from the current account when the 5-hour quota is at or below this remaining percentage."
        },
        "codexAccountSwitcher.autoSwitchWeeklyThreshold": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "description": "When automatic switching is enabled, switch away from the current account when the weekly quota is at or below this remaining percentage."
        },
        "codexAccountSwitcher.cooldownMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 1440,
          "description": "Minutes to avoid retrying a profile after a rate-limit failure."
        },
        "codexAccountSwitcher.cacheTtlSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 3600,
          "description": "How long cached rate-limit data may be reused."
        },
        "codexAccountSwitcher.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "description": "How often enabled account limits are refreshed in the background."
        },
        "codexAccountSwitcher.experimentalBackendRestart": {
          "type": "boolean",
          "default": false,
          "description": "Try restarting only the Codex backend when switching accounts. Experimental."
        },
        "codexAccountSwitcher.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active Codex account and cached quota in the VS Code status bar."
        },
        "codexAccountSwitcher.backgroundTokenRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Refresh saved OAuth access tokens in the background when a refresh token is available. Experimental."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "package": "npm run compile && vsce package --no-dependencies",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.2.1"
  },
  "icon": "resources/icon.png",
  "keywords": [
    "codex",
    "openai",
    "vscode",
    "accounts",
    "profiles",
    "authentication",
    "quota",
    "rate limits",
    "developer-tools"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  }
}
