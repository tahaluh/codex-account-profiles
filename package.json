{
  "name": "tahaluh-codex-account-switcher",
  "displayName": "Codex Account Profiles",
  "description": "Manage authorized Codex account profiles in VS Code while keeping chats and sessions shared.",
  "version": "0.3.16",
  "publisher": "tahaluh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tahaluh/codex-account-profiles.git"
  },
  "homepage": "https://github.com/tahaluh/codex-account-profiles#readme",
  "bugs": {
    "url": "https://github.com/tahaluh/codex-account-profiles/issues"
  },
  "engines": {
    "vscode": ">=1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexAccountProfiles",
          "title": "Codex Profiles",
          "icon": "resources/key.svg"
        }
      ]
    },
    "views": {
      "codexAccountProfiles": [
        {
          "id": "codexAccountProfiles.accountsView",
          "name": "Profiles",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codexAccountProfiles.addAccount",
        "title": "Codex: Add Account Profile"
      },
      {
        "command": "codexAccountProfiles.importCurrentAccount",
        "title": "Codex: Import Current Profile"
      },
      {
        "command": "codexAccountProfiles.reauthenticateAccount",
        "title": "Codex: Re-authenticate Profile"
      },
      {
        "command": "codexAccountProfiles.exportAccounts",
        "title": "Codex: Export Profiles"
      },
      {
        "command": "codexAccountProfiles.importAccounts",
        "title": "Codex: Import Profiles"
      },
      {
        "command": "codexAccountProfiles.removeAccount",
        "title": "Codex: Remove Profile"
      },
      {
        "command": "codexAccountProfiles.showLimits",
        "title": "Codex: Show Profile Limits"
      },
      {
        "command": "codexAccountProfiles.switchAccount",
        "title": "Codex: Switch Profile"
      },
      {
        "command": "codexAccountProfiles.startCodex",
        "title": "Codex: Start with Available Profile"
      },
      {
        "command": "codexAccountProfiles.openLauncherFolder",
        "title": "Codex: Open Launcher Folder"
      },
      {
        "command": "codexAccountProfiles.enableNativeIntegration",
        "title": "Codex: Enable Native Integration"
      },
      {
        "command": "codexAccountProfiles.disableNativeIntegration",
        "title": "Codex: Disable Native Integration"
      }
    ],
    "configuration": {
      "title": "Codex Account Profiles",
      "properties": {
        "codexAccountProfiles.autoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch to another available profile only after a confirmed limit event."
        },
        "codexAccountProfiles.startupSelectionMode": {
          "type": "number",
          "enum": [
            1,
            2
          ],
          "enumDescriptions": [
            "Read each account's quota without sending a prompt.",
            "Send the startup probe prompt to each account, then select the account with the most remaining quota."
          ],
          "default": 2,
          "description": "How accounts are checked before the initial Codex session."
        },
        "codexAccountProfiles.startupProbePrompt": {
          "type": "string",
          "default": "Reply with OK.",
          "description": "Small prompt sent once to each account when startupSelectionMode is 2."
        },
        "codexAccountProfiles.confirmBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before changing the selected profile."
        },
        "codexAccountProfiles.minimumRemainingPercent": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum remaining quota required for a profile to be considered available."
        },
        "codexAccountProfiles.cooldownMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 1440,
          "description": "Minutes to avoid retrying a profile after a rate-limit failure."
        },
        "codexAccountProfiles.cacheTtlSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 3600,
          "description": "How long cached rate-limit data may be reused."
        },
        "codexAccountProfiles.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "description": "How often enabled account limits are refreshed in the background."
        },
        "codexAccountProfiles.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active Codex account and cached quota in the VS Code status bar."
        },
        "codexAccountProfiles.backgroundTokenRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Refresh saved OAuth access tokens in the background when a refresh token is available. Experimental."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "package": "npm run compile && vsce package --no-dependencies",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.2.1"
  },
  "icon": "resources/icon.png",
  "keywords": [
    "codex",
    "openai",
    "vscode",
    "accounts",
    "profiles",
    "authentication",
    "quota",
    "rate limits",
    "developer-tools"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  }
}
