#!/usr/bin/env node

// The VS Code extension can use this launcher as the Codex CLI executable.
// Account selection is performed before the CLI process starts.
const { spawn } = require("node:child_process");
const { existsSync, readFileSync, writeFileSync, mkdirSync, renameSync, unlinkSync } = require("node:fs");
const { createInterface } = require("node:readline");
const { homedir } = require("node:os");
const { dirname, join } = require("node:path");
const { ensureWritableAuthHome } = require("./auth-home");
const { prepareSharedHome } = require("./shared-home");
const { createTurnLifecycle } = require("./turn-lifecycle");
const { createConversationState, isMissingRollout } = require("./conversation-state");
const { isConfirmedRateLimitDiagnostic, isConfirmedRateLimitMessage } = require("./proxy-policy");
const { resolveDataDir, runtimeDataDir } = require("./data-dir");

// VS Code's Electron executable can run this script as Node during login.
// Do not leak that mode to Codex or to the browser it opens for authentication.
delete process.env.ELECTRON_RUN_AS_NODE;

const DEFAULT_PROXY_LIMIT_COOLDOWN_MS = 10 * 60 * 1000;

function start(home, cleanup = () => {}, runtime = {}, extraArgs = []) {
  const child = spawn("codex", [...extraArgs, ...process.argv.slice(2)], {
    stdio: ["inherit", "inherit", "pipe"],
    env: { ...process.env, CODEX_HOME: home },
  });
  if (runtime.dataDir) {
    try { writeFileSync(join(runtime.dataDir, "codex.pid"), String(child.pid), { mode: 0o600 }); } catch { /* Best effort runtime metadata. */ }
  }
  let limitReported = false;
  child.stderr.on("data", (chunk) => {
    process.stderr.write(chunk);
    const message = chunk.toString();
    if (!limitReported && isConfirmedRateLimitDiagnostic(message)) {
      limitReported = true;
      try {
        writeJsonAtomicSync(join(runtime.dataDir, "rate-limit-trigger.json"), { accountId: runtime.accountId, detectedAt: Date.now() });
      } catch { /* The extension can still detect exhaustion through polling. */ }
    }
  });
  child.once("error", () => { process.stderr.write("Could not start Codex. Check that codex is on PATH.\n"); process.exitCode = 1; });
  for (const signal of ["SIGTERM", "SIGINT"]) process.on(signal, () => { try { child.kill(signal); } catch {} });
  child.on("exit", (code, signal) => {
    cleanup();
    if (runtime.dataDir) {
      removePidFileIfOwned(runtime.dataDir, child.pid);
    }
    if (signal) process.exit(signal === "SIGINT" ? 130 : 143);
    else process.exit(code ?? 1);
  });
}

function recordCurrentAccount(dataDir, account) {
  try {
    writeJsonAtomicSync(join(dataDir, "current-account.json"), { accountId: account.id, name: account.name, startedAt: Date.now() });
    writeJsonAtomicSync(join(dataDir, "selection.json"), { accountId: account.id });
  } catch { /* Runtime status is best effort. */ }
}

function writeJsonAtomicSync(file, value) {
  const temp = `${file}.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}.tmp`;
  mkdirSync(dirname(file), { recursive: true, mode: 0o700 });
  writeFileSync(temp, JSON.stringify(value, null, 2), { mode: 0o600 });
  renameSync(temp, file);
}

function removePidFileIfOwned(dataDir, pid) {
  try {
    const pidPath = join(dataDir, "codex.pid");
    if (Number(readFileSync(pidPath, "utf8")) === pid) unlinkSync(pidPath);
  } catch { /* Runtime metadata may already be gone. */ }
}

function stopBackendProcess(backendChild, timeoutMs = 5000) {
  if (!backendChild || backendChild.exitCode !== null || backendChild.signalCode !== null) return Promise.resolve();
  return new Promise((resolve) => {
    let termTimer;
    let forceTimer;
    const finish = () => {
      clearTimeout(termTimer);
      clearTimeout(forceTimer);
      resolve();
    };
    backendChild.once("exit", finish);
    try { backendChild.kill("SIGTERM"); } catch { finish(); return; }
    termTimer = setTimeout(() => {
      try { backendChild.kill("SIGKILL"); } catch { finish(); return; }
      forceTimer = setTimeout(finish, 1000);
    }, timeoutMs);
  });
}

function readLimits(home) {
  return new Promise((resolve) => {
    const child = spawn("codex", ["-c", 'cli_auth_credentials_store="file"', "app-server"], {
      env: { ...process.env, CODEX_HOME: home },
      stdio: ["pipe", "pipe", "ignore"],
    });
    const rl = createInterface({ input: child.stdout });
    const finish = (result = null) => { clearTimeout(timeout); rl.close(); child.kill(); resolve(result); };
    const timeout = setTimeout(finish, 10000);
    child.once("error", () => finish());
    child.once("exit", () => finish());
    child.stdin.on("error", () => finish());
    rl.on("line", (line) => {
      try {
        const message = JSON.parse(line);
        if (message.id === 1) {
          child.stdin.write(JSON.stringify({ method: "initialized" }) + "\n");
          child.stdin.write(JSON.stringify({ id: 2, method: "account/rateLimits/read", params: {} }) + "\n");
        }
        if (message.id === 2) {
          clearTimeout(timeout);
          rl.close();
          child.kill();
          resolve(message.result || null);
        }
      } catch { /* Ignore non-JSON diagnostics. */ }
    });
    child.stdin.write(JSON.stringify({ id: 1, method: "initialize", params: {
      clientInfo: { name: "codex-account-profiles", title: "Codex Account Profiles", version: "0.1.0" },
    } }) + "\n");
  });
}

function runStartupProbe(home, prompt) {
  return new Promise((resolve) => {
    const child = spawn("codex", ["-c", 'cli_auth_credentials_store="file"', "exec", "--ephemeral", "--skip-git-repo-check", prompt], {
      env: { ...process.env, CODEX_HOME: home },
      stdio: ["ignore", "ignore", "ignore"],
    });
    const timeout = setTimeout(() => {
      child.kill("SIGTERM");
      resolve(false);
    }, 30000);
    child.once("error", () => {
      clearTimeout(timeout);
      resolve(false);
    });
    child.once("exit", (code) => {
      clearTimeout(timeout);
      resolve(code === 0);
    });
  });
}

function remaining(result) {
  const buckets = Object.keys(result?.rateLimitsByLimitId || {}).length
    ? Object.values(result.rateLimitsByLimitId)
    : [result?.rateLimits || result || {}];
  const values = buckets.flatMap((limits) => [limits.primary, limits.secondary])
    .filter(Boolean)
    .map((window) => Math.max(0, 100 - (window.usedPercent ?? 100)));
  return values.length ? Math.min(...values) : 0;
}

function startProxy(dataDir, selected, accounts, backendArgs, autoSwitch, proxyLimitCooldownMs = DEFAULT_PROXY_LIMIT_COOLDOWN_MS, registryDir = dataDir) {
  if (!Number.isFinite(proxyLimitCooldownMs) || proxyLimitCooldownMs < 0) proxyLimitCooldownMs = DEFAULT_PROXY_LIMIT_COOLDOWN_MS;
  let current = selected;
  let child;
  let shared;
  let initRequest;
  let initializedMessage;
  let exhausted = false;
  let switching = false;
  let lastSwitchError;
  const turnLifecycle = createTurnLifecycle();
  let deferredSwitchTimer;
  let exhaustionSwitchAttempted = false;
  let clientQueue = Promise.resolve();
  let recovering = false;
  let proxyClosing = false;
  const limitedUntil = new Map();
  const conversations = createConversationState();
  let restoring = false;
  const pendingRequests = new Map();
  const internalRequests = new Map();
  const pendingSince = new Map();
  const ignoredReplies = new Set();
  const isReadOnly = (method) => /\/(?:read|list|get|status)$/.test(method || "");
  const canSwitch = () => !restoring && turnLifecycle.isIdle() && ![...pendingRequests.values()].some((request) => !isReadOnly(request.method));
  const rejectPending = (id, message) => {
    pendingRequests.delete(id);
    pendingSince.delete(id);
    ignoredReplies.add(id);
    if (ignoredReplies.size > 1000) ignoredReplies.delete(ignoredReplies.values().next().value);
    process.stdout.write(JSON.stringify({ id, error: { code: -32603, message } }) + "\n");
  };

  const reloadAccounts = () => {
    const registry = JSON.parse(readFileSync(join(registryDir, "accounts.json"), "utf8"));
    const registered = Array.isArray(registry) ? registry : registry.accounts;
    if (!Array.isArray(registered)) throw new Error("Account registry has no accounts array");
    if (!Array.isArray(registry)) {
      autoSwitch = registry.autoSwitch === true;
      const configuredCooldown = Number(registry.cooldownMinutes);
      proxyLimitCooldownMs = Number.isFinite(configuredCooldown) && configuredCooldown >= 0
        ? configuredCooldown * 60 * 1000
        : DEFAULT_PROXY_LIMIT_COOLDOWN_MS;
    }
    accounts = registered.filter((account) => account && account.enabled !== false && existsSync(account.codexHome));
    return accounts;
  };

  const consumePendingSwitchRequest = async () => {
    if (!canSwitch() || switching) return false;
    const requestPath = join(dataDir, "switch-request.json");
    const claimedPath = join(dataDir, `.switch-request-${process.pid}.json`);
    try { renameSync(requestPath, claimedPath); } catch (error) {
      if (error.code !== "ENOENT") process.stderr.write("Could not read a pending Codex switch.\n");
      return false;
    }
    let request;
    try {
      request = JSON.parse(readFileSync(claimedPath, "utf8"));
      reloadAccounts();
      const available = accounts.some((account) => account.id === request.accountId);
      writeJsonAtomicSync(join(dataDir, "switch-progress.json"), { ...request, phase: "switching", updatedAt: Date.now(), launcherPid: process.pid });
      const switched = available && (request.accountId === current.id || await switchBackend(request.accountId));
      writeJsonAtomicSync(join(dataDir, "switch-result.json"), {
        accountId: request.accountId,
        requestId: request.requestId,
        success: Boolean(switched),
        completedAt: Date.now(),
        error: switched ? undefined : available ? lastSwitchError || "Backend switch failed" : "Account is unavailable",
      });
      return Boolean(switched);
    } catch (error) {
      if (request?.accountId) writeJsonAtomicSync(join(dataDir, "switch-result.json"), {
        accountId: request.accountId, requestId: request.requestId, success: false, completedAt: Date.now(), error: "Could not process the profile switch",
      });
      process.stderr.write("Could not process a pending Codex switch.\n");
      return false;
    } finally {
      try { unlinkSync(claimedPath); } catch {}
    }
  };

  const spawnBackend = (account, replay) => new Promise((resolve, reject) => {
    const backendShared = prepareSharedHome(account.codexHome);
    const backendChild = spawn("codex", [...backendShared.args, ...backendArgs], {
      env: { ...process.env, CODEX_HOME: backendShared.home },
      stdio: ["pipe", "pipe", "pipe"],
    });
    shared = backendShared;
    child = backendChild;
    try { writeFileSync(join(dataDir, "codex.pid"), String(backendChild.pid), { mode: 0o600 }); } catch { /* Best effort runtime metadata. */ }
    const replayReplies = new Map();
    const timeout = setTimeout(() => reject(new Error("Codex backend initialization or conversation restoration timed out")), 15000);
    const rl = createInterface({ input: backendChild.stdout });
    rl.on("line", (line) => {
      if (backendChild !== child) return;
      let message;
      try { message = JSON.parse(line); } catch { process.stdout.write(line + "\n"); return; }
      if (!message.method && ignoredReplies.has(message.id)) { ignoredReplies.delete(message.id); return; }
      if (!message.method && internalRequests.has(message.id)) {
        const reply = internalRequests.get(message.id);
        internalRequests.delete(message.id);
        clearTimeout(reply.timer);
        if (message.error) reply.reject(new Error(message.error.message || "Could not restore the requested conversation"));
        else reply.resolve(message.result);
        return;
      }
      if (!message.method && replayReplies.has(message.id)) {
        const reply = replayReplies.get(message.id);
        replayReplies.delete(message.id);
        if (message.error) {
          const error = new Error(message.error.message || "Codex could not restore a conversation");
          error.code = message.error.code;
          reply.reject(error);
        } else reply.resolve(message.result);
        return;
      }
      if (!message.method && message.id === initRequest?.id) {
        if (message.error) {
          clearTimeout(timeout);
          reject(new Error("Codex initialization failed"));
          return;
        }
        if (!replay) {
          clearTimeout(timeout);
          recordCurrentAccount(dataDir, account);
          process.stdout.write(line + "\n");
          resolve();
          return;
        }
        if (initializedMessage) backendChild.stdin.write(JSON.stringify(initializedMessage) + "\n");
        restoring = true;
        conversations.resetLoaded();
        const restored = conversations.records().map((record) => {
          const replayId = `codex-account-profiles-replay-${Date.now()}-${Math.random().toString(36).slice(2)}`;
          const reply = new Promise((resolve, reject) => replayReplies.set(replayId, { resolve, reject }));
          backendChild.stdin.write(JSON.stringify({ method: "thread/resume", params: conversations.resume(record), id: replayId }) + "\n");
          return reply.then((result) => {
            conversations.attach(record, result?.thread?.id || record.backendId);
          }).catch((error) => {
            // A closed/empty tab must not veto changing the account. It can be
            // resumed or recreated when the client next uses that conversation.
            if (!isMissingRollout(error)) throw new Error("Codex could not restore a conversation; the previous account will be recovered.");
          });
        });
        Promise.all(restored).then(() => {
          restoring = false;
          clearTimeout(timeout);
          recordCurrentAccount(dataDir, account);
          resolve();
        }, (error) => { restoring = false; clearTimeout(timeout); reject(error); });
        return;
      }
      const request = !message.method && pendingRequests.get(message.id);
      if (request) {
        pendingRequests.delete(message.id);
        pendingSince.delete(message.id);
        if (!message.error) {
          conversations.remember(request, message.result);
          conversations.noteRequest(request);
          if (["thread/archive", "thread/unsubscribe"].includes(request.method)) conversations.remove(request.params?.threadId);
        }
      }
      message = conversations.toClient(message);
      if (turnLifecycle.recordBackendMessage(message)) {
        try {
          writeJsonAtomicSync(join(dataDir, "turn-finished.json"), {
            accountId: current.id,
            finishedAt: Date.now(),
            method: message.method,
          });
        } catch {}
      }
      if (isConfirmedRateLimitMessage(message)) {
        exhausted = true;
        exhaustionSwitchAttempted = false;
        try { writeJsonAtomicSync(join(dataDir, "rate-limit-trigger.json"), { accountId: current.id, detectedAt: Date.now() }); } catch {}
      }
      if (!restoring || message.id !== undefined) process.stdout.write(JSON.stringify(message) + "\n");
      if (canSwitch()) schedulePendingSwitch();
    });
    backendChild.stderr.on("data", (chunk) => {
      process.stderr.write(chunk);
      if (isConfirmedRateLimitDiagnostic(chunk.toString())) {
        exhausted = true;
        exhaustionSwitchAttempted = false;
        try { writeJsonAtomicSync(join(dataDir, "rate-limit-trigger.json"), { accountId: current.id, detectedAt: Date.now() }); } catch {}
        if (canSwitch()) schedulePendingSwitch();
      }
    });
    backendChild.once("error", reject);
    backendChild.once("exit", (code, signal) => {
      clearTimeout(timeout);
      removePidFileIfOwned(dataDir, backendChild.pid);
      reject(new Error(`Codex backend exited during initialization or restoration (${signal || code || "unknown"})`));
      for (const reply of replayReplies.values()) reply.reject(new Error("Codex backend exited"));
      replayReplies.clear();
      if (backendChild !== child || switching) return;
      try { backendShared.cleanup(); } catch {}
      child = undefined;
      shared = undefined;
      for (const reply of internalRequests.values()) { clearTimeout(reply.timer); reply.reject(new Error("Codex backend exited")); }
      internalRequests.clear();
      for (const id of pendingRequests.keys()) process.stdout.write(JSON.stringify({ id, error: { code: -32603, message: "Codex backend exited; retry the request after reconnection." } }) + "\n");
      pendingRequests.clear();
      pendingSince.clear();
      turnLifecycle.reset();
      void recoverUnexpectedBackend(account, signal || code || "unknown");
    });
    if (initRequest) {
      backendChild.stdin.write(JSON.stringify(initRequest) + "\n");
    }
  });

  async function recoverUnexpectedBackend(account, reason) {
    if (recovering || switching || proxyClosing) return;
    recovering = true;
    switching = true;
    process.stderr.write(`Codex backend exited unexpectedly (${reason}); restarting it behind the proxy.\n`);
    try {
      while (!proxyClosing) {
        try {
          await spawnBackend(account, true);
          process.stderr.write("Codex backend restarted successfully.\n");
          return;
        } catch (error) {
          const failedChild = child;
          const failedShared = shared;
          await stopBackendProcess(failedChild).catch(() => undefined);
          try { failedShared?.cleanup(); } catch {}
          if (child === failedChild) child = undefined;
          if (shared === failedShared) shared = undefined;
          process.stderr.write(`Codex backend restart failed: ${error}; retrying.\n`);
          await new Promise((resolve) => setTimeout(resolve, 1000));
        }
      }
    } finally {
      switching = false;
      recovering = false;
    }
  }

  const callBackend = (method, params) => new Promise((resolve, reject) => {
    const id = `codex-account-profiles-internal-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    const timer = setTimeout(() => { internalRequests.delete(id); reject(new Error("Codex conversation request timed out")); }, 15000);
    internalRequests.set(id, { resolve, reject, timer });
    child.stdin.write(JSON.stringify({ id, method, params }) + "\n");
  });

  const ensureConversation = async (message) => {
    const record = conversations.get(message.params?.threadId);
    if (!record || record.loaded || ["thread/archive", "thread/unsubscribe"].includes(message.method)) return;
    restoring = true;
    try {
      let result;
      try { result = await callBackend("thread/resume", conversations.resume(record)); }
      catch (error) {
        if (!isMissingRollout(error) || record.hasTurns || !record.startParams) throw error;
        // Empty conversations have no persisted rollout yet. Recreate only the
        // empty session and keep its original client identity via protocol mapping.
        result = await callBackend("thread/start", record.startParams);
      }
      conversations.attach(record, result.thread.id);
    } finally { restoring = false; }
  };

  const switchBackend = async (requestedId) => {
    if (!canSwitch() || switching) return false;
    if (!requestedId && exhaustionSwitchAttempted) return false;
    if (!requestedId) exhaustionSwitchAttempted = true;
    switching = true;
    lastSwitchError = undefined;
    const previousAccount = current;
    const previousChild = child;
    const previousShared = shared;
    let previousStopped = false;
    try {
      if (!requestedId && remaining(await readLimits(current.codexHome)) >= 100) {
        exhausted = false;
        return false;
      }
      reloadAccounts();
      if (!requestedId) limitedUntil.set(current.id, Date.now() + proxyLimitCooldownMs);
      const candidates = [];
      for (const account of accounts) {
        if (account.id === current.id || account.enabled === false) continue;
        if (requestedId && account.id !== requestedId) continue;
        if (!requestedId && (limitedUntil.get(account.id) ?? 0) > Date.now()) continue;
        const score = requestedId ? 100 : remaining(await readLimits(account.codexHome));
        if (requestedId || score >= 100) candidates.push({ account, score });
      }
      candidates.sort((a, b) => b.score - a.score);
      if (!candidates.length) return false;
      // Release native conversation writer locks before resuming in the new
      // account. Never read full histories just to decide whether to switch.
      for (const id of pendingRequests.keys()) rejectPending(id, "Codex is changing accounts. Retry this request after the switch.");
      previousStopped = true;
      await stopBackendProcess(previousChild);
      const replacement = candidates[0].account;
      await spawnBackend(replacement, true);
      current = replacement;
      exhausted = false;
      exhaustionSwitchAttempted = false;
      try { unlinkSync(join(dataDir, "rate-limit-trigger.json")); } catch {}
      return true;
    } catch (error) {
      lastSwitchError = error.message || "Backend switch failed";
      current = previousAccount;
      if (child !== previousChild) {
        const failedChild = child;
        const failedShared = shared;
        await stopBackendProcess(failedChild).catch(() => undefined);
        try { failedShared?.cleanup(); } catch {}
      }
      child = previousChild;
      shared = previousShared;
      if (!previousStopped && previousChild && previousChild.exitCode === null && previousChild.signalCode === null) {
        try { writeFileSync(join(dataDir, "codex.pid"), String(previousChild.pid), { mode: 0o600 }); } catch {}
        recordCurrentAccount(dataDir, previousAccount);
      } else {
        child = undefined;
        shared = undefined;
        try { await spawnBackend(previousAccount, true); } catch (restoreError) {
          process.stderr.write(`Codex previous backend restore failed: ${restoreError}\n`);
        }
      }
      process.stderr.write(`Codex account switch failed: ${error}\n`);
      return false;
    } finally {
      switching = false;
    }
  };

  const schedulePendingSwitch = () => {
    if (deferredSwitchTimer || !canSwitch() || switching) return;
    deferredSwitchTimer = setTimeout(async () => {
      deferredSwitchTimer = undefined;
      if (!canSwitch() || switching) return;
      try { reloadAccounts(); } catch (error) { process.stderr.write(`Codex registry reload failed: ${error}\n`); }
      const switched = await consumePendingSwitchRequest();
      if (!switched && autoSwitch && exhausted && canSwitch() && !switching) await switchBackend();
    }, 100);
  };

  const writeRuntime = () => {
    for (const [id, startedAt] of pendingSince) {
      const request = pendingRequests.get(id);
      if (request && isReadOnly(request.method) && Date.now() - startedAt >= 30000) rejectPending(id, "Codex did not answer this read request in time. Retry the request.");
    }
    try { writeJsonAtomicSync(join(dataDir, "launcher.json"), {
      pid: process.pid, hostPid: process.ppid, version: "0.3.18", updatedAt: Date.now(),
      phase: switching ? "switching" : canSwitch() ? "idle" : "busy",
      accountId: current.id, activeTurns: !turnLifecycle.isIdle(),
    }); } catch {}
    if (!canSwitch() && !switching) {
      try {
        const request = JSON.parse(readFileSync(join(dataDir, "switch-request.json"), "utf8"));
        writeJsonAtomicSync(join(dataDir, "switch-progress.json"), { ...request, phase: "waiting", updatedAt: Date.now(), launcherPid: process.pid });
      } catch {}
    }
  };
  writeRuntime();
  const heartbeat = setInterval(writeRuntime, 1000);
  const pendingSwitchTimer = setInterval(() => {
    if (switching || !canSwitch()) return;
    void consumePendingSwitchRequest().catch((error) => {
      process.stderr.write(`Codex pending switch failed: ${error}\n`);
    });
  }, 500);

  const client = createInterface({ input: process.stdin });
  const handleClientLine = async (line) => {
    let message;
    try { message = JSON.parse(line); } catch { return; }
    if (message.method === "initialize") {
      initRequest = message;
      await spawnBackend(current, false);
      return;
    }
    if (message.method === "initialized") initializedMessage = message;
    // A pending switch is consumed by the terminal backend event. Never switch
    // as a side effect of forwarding an arbitrary client line.
    while (switching) await new Promise((resolve) => setTimeout(resolve, 50));
    if (child?.stdin.writable) {
      try { await ensureConversation(message); }
      catch {
        if (message.id !== undefined) process.stdout.write(JSON.stringify({ id: message.id, error: { code: -32603, message: "This conversation could not be restored. Reopen it from history and retry; the selected account remains active." } }) + "\n");
        return;
      }
      turnLifecycle.recordClientMessage(message);
      if (message.id !== undefined && message.method) {
        ignoredReplies.delete(message.id);
        pendingRequests.set(message.id, message);
        pendingSince.set(message.id, Date.now());
      }
      child.stdin.write(JSON.stringify(conversations.toBackend(message)) + "\n");
    } else if (message.id !== undefined && message.method) {
      process.stdout.write(JSON.stringify({ id: message.id, error: { code: -32603, message: "Codex backend is unavailable; retry the request." } }) + "\n");
    }
  };
  client.on("line", (line) => {
    try {
      const response = JSON.parse(line);
      if (response.id !== undefined && !response.method) {
        if (child?.stdin.writable) child.stdin.write(line + "\n");
        return;
      }
    } catch {}
    clientQueue = clientQueue.then(() => handleClientLine(line)).catch((error) => {
      process.stderr.write(`Codex client message failed: ${error}\n`);
    });
  });
  const close = async () => {
    if (proxyClosing) return;
    proxyClosing = true;
    clearInterval(pendingSwitchTimer);
    clearInterval(heartbeat);
    try { unlinkSync(join(dataDir, "launcher.json")); } catch {}
    clearTimeout(deferredSwitchTimer);
    await stopBackendProcess(child);
    try { shared?.cleanup(); } catch {}
    process.exit(0);
  };
  process.stdin.on("end", () => void close());
  process.on("SIGTERM", () => void close());
  process.on("SIGINT", () => void close());
}

async function main() {
  const args = process.argv.slice(2);
  if (args.includes("login") || process.env.CODEX_ACCOUNT_PROFILES_DISABLE === "1") {
    const home = process.env.CODEX_HOME || join(homedir(), ".codex");
    ensureWritableAuthHome(home);
    start(home, undefined, undefined, ["-c", 'cli_auth_credentials_store="file"']);
    return;
  }
  const registryDir = resolveDataDir();
  const dataDir = runtimeDataDir(registryDir);
  mkdirSync(dataDir, { recursive: true, mode: 0o700 });
  let registry = {};
  try { registry = JSON.parse(readFileSync(join(registryDir, "accounts.json"), "utf8")); } catch { /* Fall back to the normal Codex profile. */ }
  let accounts = Array.isArray(registry) ? registry : (registry.accounts || []);
  accounts = accounts.filter((account) => account.enabled !== false && existsSync(account.codexHome));
  if (!accounts.length) {
    start(process.env.CODEX_HOME || join(homedir(), ".codex"));
    return;
  }
  let preference;
  try { preference = JSON.parse(readFileSync(join(dataDir, "selection.json"), "utf8")).accountId; } catch {}
  const forcedId = process.env.CODEX_ACCOUNT_PROFILES_ACCOUNT_ID || preference || registry.forcedAccountId;
  const forced = accounts.find((account) => account.id === forcedId);
  if (process.env.CODEX_ACCOUNT_PROFILES_ACCOUNT_ID && !forced) throw new Error("The selected profile is unavailable");
  if (forced) {
    if (registry.forcedAccountId) {
      try { writeJsonAtomicSync(join(registryDir, "accounts.json"), { ...registry, forcedAccountId: null }); } catch { /* Legacy one-shot preference. */ }
    }
    if (args.includes("app-server")) {
      startProxy(dataDir, forced, accounts, args, registry.autoSwitch === true, Number(registry.cooldownMinutes) * 60 * 1000, registryDir);
    } else {
      recordCurrentAccount(dataDir, forced);
      const shared = prepareSharedHome(forced.codexHome);
      start(shared.home, shared.cleanup, { dataDir, accountId: forced.id }, shared.args);
    }
    return;
  }
  let selected = accounts[0];
  if (!Array.isArray(registry) && Number(registry.startupSelectionMode) === 2) {
    const prompt = typeof registry.startupProbePrompt === "string" && registry.startupProbePrompt.trim()
      ? registry.startupProbePrompt.trim()
      : "Reply with OK.";
    for (const account of accounts) await runStartupProbe(account.codexHome, prompt);
  }
  let best = -1;
  for (const account of accounts) {
    const score = remaining(await readLimits(account.codexHome));
    if (score > best) { best = score; selected = account; }
  }
  if (args.includes("app-server")) {
    startProxy(dataDir, selected, accounts, args, registry.autoSwitch === true, Number(registry.cooldownMinutes) * 60 * 1000, registryDir);
  } else {
    recordCurrentAccount(dataDir, selected);
    const shared = prepareSharedHome(selected.codexHome);
    start(shared.home, shared.cleanup, { dataDir, accountId: selected.id }, shared.args);
  }
}

void main().catch((error) => { process.stderr.write(`Codex launcher failed: ${error.message}\n`); process.exitCode = 1; });
