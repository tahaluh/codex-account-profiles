#!/usr/bin/env node

// The VS Code extension can use this launcher as the Codex CLI executable.
// Account selection is performed before the CLI process starts.
const { spawn } = require("node:child_process");
const { existsSync, readFileSync, writeFileSync, mkdirSync, renameSync, symlinkSync, lstatSync, unlinkSync } = require("node:fs");
const { createInterface } = require("node:readline");
const { homedir } = require("node:os");
const { dirname, join } = require("node:path");
const { ensureWritableAuthHome } = require("./auth-home");
const { acquireAuthLock } = require("./auth-lock");
const { createTurnLifecycle } = require("./turn-lifecycle");
const { isConfirmedRateLimitDiagnostic, isConfirmedRateLimitMessage } = require("./proxy-policy");
const { resolveDataDir } = require("./data-dir");

// VS Code's Electron executable can run this script as Node during login.
// Do not leak that mode to Codex or to the browser it opens for authentication.
delete process.env.ELECTRON_RUN_AS_NODE;

const DEFAULT_PROXY_LIMIT_COOLDOWN_MS = 10 * 60 * 1000;

function start(home, cleanup = () => {}, runtime = {}) {
  const child = spawn("codex", process.argv.slice(2), {
    stdio: ["inherit", "inherit", "pipe"],
    env: { ...process.env, CODEX_HOME: home },
  });
  if (runtime.dataDir) {
    try { writeFileSync(join(runtime.dataDir, "codex.pid"), String(child.pid), { mode: 0o600 }); } catch { /* Best effort runtime metadata. */ }
  }
  let limitReported = false;
  child.stderr.on("data", (chunk) => {
    process.stderr.write(chunk);
    const message = chunk.toString();
    if (!limitReported && isConfirmedRateLimitDiagnostic(message)) {
      limitReported = true;
      try {
        writeJsonAtomicSync(join(runtime.dataDir, "rate-limit-trigger.json"), { accountId: runtime.accountId, detectedAt: Date.now() });
      } catch { /* The extension can still detect exhaustion through polling. */ }
    }
  });
  child.on("exit", (code, signal) => {
    cleanup();
    if (runtime.dataDir) {
      removePidFileIfOwned(runtime.dataDir, child.pid);
    }
    if (signal) process.kill(process.pid, signal);
    else process.exit(code ?? 1);
  });
}

function recordCurrentAccount(dataDir, account) {
  try {
    writeJsonAtomicSync(join(dataDir, "current-account.json"), { accountId: account.id, name: account.name, startedAt: Date.now() });
  } catch { /* Runtime status is best effort. */ }
}

function useSharedHome(accountHome) {
  const sharedHome = process.env.CODEX_SHARED_HOME || join(homedir(), ".codex");
  const sharedAuth = join(sharedHome, "auth.json");
  const backupAuth = join(sharedHome, ".codex-account-profiles-original-auth.json");
  const accountAuth = join(accountHome, "auth.json");
  if (!existsSync(accountAuth)) return { home: sharedHome, cleanup: () => {} };
  mkdirSync(sharedHome, { recursive: true, mode: 0o700 });
  mkdirSync(accountHome, { recursive: true, mode: 0o700 });
  const releaseLock = acquireAuthLock(sharedHome);
  try {
    if (existsSync(backupAuth)) {
      if (existsSync(sharedAuth) || lstatSafe(sharedAuth)) unlinkSync(sharedAuth);
      renameSync(backupAuth, sharedAuth);
    }
    if (existsSync(sharedAuth) || lstatSafe(sharedAuth)) renameSync(sharedAuth, backupAuth);
    symlinkSync(accountAuth, sharedAuth);
  } catch (error) {
    releaseLock();
    throw error;
  }
  let restored = false;
  return {
    home: sharedHome,
    cleanup: () => {
      if (restored) return;
      restored = true;
      if (lstatSafe(sharedAuth)) unlinkSync(sharedAuth);
      if (existsSync(backupAuth)) renameSync(backupAuth, sharedAuth);
      releaseLock();
    },
  };
}

function lstatSafe(file) {
  try { lstatSync(file); return true; } catch { return false; }
}

function writeJsonAtomicSync(file, value) {
  const temp = `${file}.${process.pid}.${Date.now()}.${Math.random().toString(36).slice(2)}.tmp`;
  mkdirSync(dirname(file), { recursive: true, mode: 0o700 });
  writeFileSync(temp, JSON.stringify(value, null, 2), { mode: 0o600 });
  renameSync(temp, file);
}

function removePidFileIfOwned(dataDir, pid) {
  try {
    const pidPath = join(dataDir, "codex.pid");
    if (Number(readFileSync(pidPath, "utf8")) === pid) unlinkSync(pidPath);
  } catch { /* Runtime metadata may already be gone. */ }
}

function stopBackendProcess(backendChild, timeoutMs = 5000) {
  if (!backendChild || backendChild.exitCode !== null || backendChild.signalCode !== null) return Promise.resolve();
  return new Promise((resolve) => {
    let termTimer;
    let forceTimer;
    const finish = () => {
      clearTimeout(termTimer);
      clearTimeout(forceTimer);
      resolve();
    };
    backendChild.once("exit", finish);
    try { backendChild.kill("SIGTERM"); } catch { finish(); return; }
    termTimer = setTimeout(() => {
      try { backendChild.kill("SIGKILL"); } catch { finish(); return; }
      forceTimer = setTimeout(finish, 1000);
    }, timeoutMs);
  });
}

function readLimits(home) {
  return new Promise((resolve) => {
    const child = spawn("codex", ["app-server"], {
      env: { ...process.env, CODEX_HOME: home },
      stdio: ["pipe", "pipe", "ignore"],
    });
    const rl = createInterface({ input: child.stdout });
    const timeout = setTimeout(() => { rl.close(); child.kill(); resolve(null); }, 10000);
    rl.on("line", (line) => {
      try {
        const message = JSON.parse(line);
        if (message.id === 1) {
          child.stdin.write(JSON.stringify({ method: "initialized" }) + "\n");
          child.stdin.write(JSON.stringify({ id: 2, method: "account/rateLimits/read", params: {} }) + "\n");
        }
        if (message.id === 2) {
          clearTimeout(timeout);
          rl.close();
          child.kill();
          resolve(message.result || null);
        }
      } catch { /* Ignore non-JSON diagnostics. */ }
    });
    child.stdin.write(JSON.stringify({ id: 1, method: "initialize", params: {
      clientInfo: { name: "codex-account-profiles", title: "Codex Account Profiles", version: "0.1.0" },
    } }) + "\n");
  });
}

function runStartupProbe(home, prompt) {
  return new Promise((resolve) => {
    const child = spawn("codex", ["exec", "--skip-git-repo-check", prompt], {
      env: { ...process.env, CODEX_HOME: home },
      stdio: ["ignore", "ignore", "ignore"],
    });
    const timeout = setTimeout(() => {
      child.kill("SIGTERM");
      resolve(false);
    }, 30000);
    child.once("error", () => {
      clearTimeout(timeout);
      resolve(false);
    });
    child.once("exit", (code) => {
      clearTimeout(timeout);
      resolve(code === 0);
    });
  });
}

function remaining(result) {
  const buckets = Object.keys(result?.rateLimitsByLimitId || {}).length
    ? Object.values(result.rateLimitsByLimitId)
    : [result?.rateLimits || result || {}];
  const values = buckets.flatMap((limits) => [limits.primary, limits.secondary])
    .filter(Boolean)
    .map((window) => Math.max(0, 100 - (window.usedPercent ?? 100)));
  return values.length ? Math.min(...values) : 0;
}

function startProxy(dataDir, selected, accounts, backendArgs, autoSwitch, proxyLimitCooldownMs = DEFAULT_PROXY_LIMIT_COOLDOWN_MS) {
  if (!Number.isFinite(proxyLimitCooldownMs) || proxyLimitCooldownMs < 0) proxyLimitCooldownMs = DEFAULT_PROXY_LIMIT_COOLDOWN_MS;
  let current = selected;
  let child;
  let shared;
  let initRequest;
  let initializedMessage;
  let exhausted = false;
  let switching = false;
  const turnLifecycle = createTurnLifecycle();
  let deferredSwitchTimer;
  let exhaustionSwitchAttempted = false;
  let clientQueue = Promise.resolve();
  let recovering = false;
  let proxyClosing = false;
  const limitedUntil = new Map();
  const threadResumeRequests = new Map();
  const replayResponseIds = new Set();

  const reloadAccounts = () => {
    const registry = JSON.parse(readFileSync(join(dataDir, "accounts.json"), "utf8"));
    const registered = Array.isArray(registry) ? registry : registry.accounts;
    if (!Array.isArray(registered)) throw new Error("Account registry has no accounts array");
    if (!Array.isArray(registry)) {
      autoSwitch = registry.autoSwitch === true;
      const configuredCooldown = Number(registry.cooldownMinutes);
      proxyLimitCooldownMs = Number.isFinite(configuredCooldown) && configuredCooldown >= 0
        ? configuredCooldown * 60 * 1000
        : DEFAULT_PROXY_LIMIT_COOLDOWN_MS;
    }
    accounts = registered.filter((account) => account && account.enabled !== false && existsSync(account.codexHome));
    return accounts;
  };

  const consumePendingSwitchRequest = async () => {
    try {
      const requestPath = join(dataDir, "switch-request.json");
      const request = JSON.parse(readFileSync(requestPath, "utf8"));
      if (request.accountId && request.accountId !== current.id) {
        if (!turnLifecycle.isIdle() || switching) return false;
        reloadAccounts();
        if (!accounts.some((account) => account.id === request.accountId)) {
          unlinkSync(requestPath);
          writeJsonAtomicSync(join(dataDir, "switch-result.json"), {
            accountId: request.accountId,
            success: false,
            completedAt: Date.now(),
            error: "Account is unavailable",
          });
          process.stderr.write(`Codex pending switch rejected: account '${request.accountId}' is unavailable.\n`);
          return false;
        }
        const switched = await switchBackend(request.accountId);
        unlinkSync(requestPath);
        writeJsonAtomicSync(join(dataDir, "switch-result.json"), {
          accountId: request.accountId,
          success: switched,
          completedAt: Date.now(),
          error: switched ? undefined : "Backend switch failed",
        });
        return switched;
      }
      unlinkSync(requestPath);
    } catch {
      /* No pending manual switch. */
    }
    return false;
  };

  const spawnBackend = (account, replay) => new Promise((resolve, reject) => {
    const backendShared = useSharedHome(account.codexHome);
    const backendChild = spawn("codex", backendArgs, {
      env: { ...process.env, CODEX_HOME: backendShared.home },
      stdio: ["pipe", "pipe", "pipe"],
    });
    shared = backendShared;
    child = backendChild;
    try { writeFileSync(join(dataDir, "codex.pid"), String(backendChild.pid), { mode: 0o600 }); } catch { /* Best effort runtime metadata. */ }
    recordCurrentAccount(dataDir, account);
    let initialized = false;
    const timeout = setTimeout(() => reject(new Error("Codex backend initialization timed out")), 15000);
    const rl = createInterface({ input: backendChild.stdout });
    rl.on("line", (line) => {
      let message;
      try { message = JSON.parse(line); } catch { process.stdout.write(line + "\n"); return; }
      if (replayResponseIds.has(message.id)) {
        replayResponseIds.delete(message.id);
        return;
      }
      if (message.id === initRequest?.id) {
        clearTimeout(timeout);
        initialized = true;
        if (!replay) {
          process.stdout.write(line + "\n");
          resolve();
          return;
        }
        if (initializedMessage) backendChild.stdin.write(JSON.stringify(initializedMessage) + "\n");
        for (const request of threadResumeRequests.values()) {
          const replayId = `codex-account-profiles-replay-${Date.now()}-${Math.random().toString(36).slice(2)}`;
          replayResponseIds.add(replayId);
          backendChild.stdin.write(JSON.stringify({ ...request, id: replayId }) + "\n");
        }
        setTimeout(resolve, 300);
        return;
      }
      if (turnLifecycle.recordBackendMessage(message)) {
        try {
          writeJsonAtomicSync(join(dataDir, "turn-finished.json"), {
            accountId: current.id,
            finishedAt: Date.now(),
            method: message.method,
          });
        } catch {}
      }
      if (isConfirmedRateLimitMessage(message)) {
        exhausted = true;
        exhaustionSwitchAttempted = false;
        try { writeJsonAtomicSync(join(dataDir, "rate-limit-trigger.json"), { accountId: current.id, detectedAt: Date.now() }); } catch {}
      }
      process.stdout.write(line + "\n");
      if (turnLifecycle.isIdle()) schedulePendingSwitch();
    });
    backendChild.stderr.on("data", (chunk) => {
      process.stderr.write(chunk);
      if (isConfirmedRateLimitDiagnostic(chunk.toString())) {
        exhausted = true;
        exhaustionSwitchAttempted = false;
        try { writeJsonAtomicSync(join(dataDir, "rate-limit-trigger.json"), { accountId: current.id, detectedAt: Date.now() }); } catch {}
        if (turnLifecycle.isIdle()) schedulePendingSwitch();
      }
    });
    backendChild.once("error", reject);
    backendChild.once("exit", (code, signal) => {
      clearTimeout(timeout);
      removePidFileIfOwned(dataDir, backendChild.pid);
      if (!initialized) reject(new Error(`Codex backend exited before initialization (${signal || code || "unknown"})`));
      if (backendChild !== child || switching) return;
      try { backendShared.cleanup(); } catch {}
      child = undefined;
      shared = undefined;
      void recoverUnexpectedBackend(account, signal || code || "unknown");
    });
    if (initRequest) {
      backendChild.stdin.write(JSON.stringify(initRequest) + "\n");
    }
  });

  async function recoverUnexpectedBackend(account, reason) {
    if (recovering || switching || proxyClosing) return;
    recovering = true;
    switching = true;
    process.stderr.write(`Codex backend exited unexpectedly (${reason}); restarting it behind the proxy.\n`);
    try {
      while (!proxyClosing) {
        try {
          await spawnBackend(account, true);
          process.stderr.write("Codex backend restarted successfully.\n");
          return;
        } catch (error) {
          const failedChild = child;
          const failedShared = shared;
          await stopBackendProcess(failedChild).catch(() => undefined);
          try { failedShared?.cleanup(); } catch {}
          if (child === failedChild) child = undefined;
          if (shared === failedShared) shared = undefined;
          process.stderr.write(`Codex backend restart failed: ${error}; retrying.\n`);
          await new Promise((resolve) => setTimeout(resolve, 1000));
        }
      }
    } finally {
      switching = false;
      recovering = false;
    }
  }

  const switchBackend = async (requestedId) => {
    if (!turnLifecycle.isIdle() || switching) return false;
    if (!requestedId && exhaustionSwitchAttempted) return false;
    if (!requestedId) exhaustionSwitchAttempted = true;
    switching = true;
    const previousAccount = current;
    const previousChild = child;
    const previousShared = shared;
    try {
      if (!requestedId && remaining(await readLimits(current.codexHome)) >= 100) {
        exhausted = false;
        return false;
      }
      reloadAccounts();
      if (!requestedId) limitedUntil.set(current.id, Date.now() + proxyLimitCooldownMs);
      const candidates = [];
      for (const account of accounts) {
        if (account.id === current.id || account.enabled === false) continue;
        if (requestedId && account.id !== requestedId) continue;
        if (!requestedId && (limitedUntil.get(account.id) ?? 0) > Date.now()) continue;
        const score = remaining(await readLimits(account.codexHome));
        if (requestedId || score >= 100) candidates.push({ account, score });
      }
      candidates.sort((a, b) => b.score - a.score);
      if (!candidates.length) return false;
      await stopBackendProcess(previousChild);
      try { previousShared?.cleanup(); } catch {}
      if (child === previousChild) child = undefined;
      if (shared === previousShared) shared = undefined;
      current = candidates[0].account;
      exhausted = false;
      exhaustionSwitchAttempted = false;
      await spawnBackend(current, true);
      try { unlinkSync(join(dataDir, "rate-limit-trigger.json")); } catch {}
      return true;
    } catch (error) {
      // A failed switch must not leave the proxy permanently waiting in "switching".
      current = previousAccount;
      const failedChild = child;
      const failedShared = shared;
      await stopBackendProcess(failedChild).catch(() => undefined);
      try { failedShared?.cleanup(); } catch {}
      child = undefined;
      shared = undefined;
      exhausted = true;
      try {
        await spawnBackend(previousAccount, true);
        exhausted = false;
      } catch (restoreError) {
        process.stderr.write(`Codex previous backend restore failed: ${restoreError}\n`);
      }
      process.stderr.write(`Codex account switch failed: ${error}\n`);
      return false;
    } finally {
      switching = false;
    }
  };

  const schedulePendingSwitch = () => {
    if (deferredSwitchTimer || !turnLifecycle.isIdle() || switching) return;
    deferredSwitchTimer = setTimeout(async () => {
      deferredSwitchTimer = undefined;
      if (!turnLifecycle.isIdle() || switching) return;
      try { reloadAccounts(); } catch (error) { process.stderr.write(`Codex registry reload failed: ${error}\n`); }
      const switched = await consumePendingSwitchRequest();
      if (!switched && autoSwitch && exhausted && turnLifecycle.isIdle() && !switching) await switchBackend();
    }, 100);
  };

  const pendingSwitchTimer = setInterval(() => {
    if (switching || !turnLifecycle.isIdle()) return;
    void consumePendingSwitchRequest().catch((error) => {
      process.stderr.write(`Codex pending switch failed: ${error}\n`);
    });
  }, 500);

  const client = createInterface({ input: process.stdin });
  const handleClientLine = async (line) => {
    let message;
    try { message = JSON.parse(line); } catch { return; }
    if (message.method === "initialize") {
      initRequest = message;
      await spawnBackend(current, false);
      return;
    }
    if (message.method === "initialized") initializedMessage = message;
    turnLifecycle.recordClientMessage(message);
    if (message.method === "thread/resume" && message.params?.threadId) {
      threadResumeRequests.set(message.params.threadId, message);
    }
    // A pending switch is consumed by the terminal backend event. Never switch
    // as a side effect of forwarding an arbitrary client line.
    while (switching) await new Promise((resolve) => setTimeout(resolve, 50));
    if (child?.stdin.writable) child.stdin.write(line + "\n");
  };
  client.on("line", (line) => {
    clientQueue = clientQueue.then(() => handleClientLine(line)).catch((error) => {
      process.stderr.write(`Codex client message failed: ${error}\n`);
    });
  });
  process.stdin.on("end", () => { proxyClosing = true; clearInterval(pendingSwitchTimer); try { child?.kill(); } catch {} try { shared?.cleanup(); } catch {} process.exit(0); });
}

async function main() {
  const args = process.argv.slice(2);
  if (args.includes("login") || process.env.CODEX_ACCOUNT_PROFILES_DISABLE === "1") {
    const home = process.env.CODEX_HOME || join(homedir(), ".codex");
    ensureWritableAuthHome(home);
    start(home);
    return;
  }
  const dataDir = resolveDataDir();
  let registry = {};
  try { registry = JSON.parse(readFileSync(join(dataDir, "accounts.json"), "utf8")); } catch { /* Fall back to the normal Codex profile. */ }
  let accounts = Array.isArray(registry) ? registry : (registry.accounts || []);
  accounts = accounts.filter((account) => account.enabled !== false && existsSync(account.codexHome));
  if (!accounts.length) {
    start(process.env.CODEX_HOME || join(homedir(), ".codex"));
    return;
  }
  const forced = accounts.find((account) => account.id === registry.forcedAccountId);
  if (forced) {
    try { writeJsonAtomicSync(join(dataDir, "accounts.json"), { ...registry, forcedAccountId: null }); } catch { /* Continue even if the one-shot preference cannot be cleared. */ }
    recordCurrentAccount(dataDir, forced);
    if (args.includes("app-server")) {
      startProxy(dataDir, forced, accounts, args, registry.autoSwitch === true, Number(registry.cooldownMinutes) * 60 * 1000);
    } else {
      const shared = useSharedHome(forced.codexHome);
      start(shared.home, shared.cleanup, { dataDir, accountId: forced.id });
    }
    return;
  }
  let selected = accounts[0];
  if (!Array.isArray(registry) && Number(registry.startupSelectionMode) === 2) {
    const prompt = typeof registry.startupProbePrompt === "string" && registry.startupProbePrompt.trim()
      ? registry.startupProbePrompt.trim()
      : "Reply with OK.";
    for (const account of accounts) await runStartupProbe(account.codexHome, prompt);
  }
  let best = -1;
  for (const account of accounts) {
    const score = remaining(await readLimits(account.codexHome));
    if (score > best) { best = score; selected = account; }
  }
  recordCurrentAccount(dataDir, selected);
  if (args.includes("app-server")) {
    startProxy(dataDir, selected, accounts, args, registry.autoSwitch === true, Number(registry.cooldownMinutes) * 60 * 1000);
  } else {
    const shared = useSharedHome(selected.codexHome);
    start(shared.home, shared.cleanup, { dataDir, accountId: selected.id });
  }
}

void main();
